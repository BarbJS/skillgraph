# Dify release to install. Keep this pinned for reproducible setup.
DIFY_VERSION=1.17.0
DIFY_DIR=.dify

# LM Studio OpenAI-compatible server on the host machine.
LM_STUDIO_HOST=127.0.0.1
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio-local
LM_STUDIO_CHAT_MODEL=meta-llama-3-8b-instruct
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Published Dify Chatflow API (keep the real key only in local .env)
DIFY_API_BASE_URL=http://localhost
DIFY_API_KEY=replace-with-your-local-dify-chatflow-key
DIFY_USER_ID=skillgraph-local-user

# Optional TypeSafe/JEV integration. Keep disabled until credentials are provided.
JEV_ENABLED=false
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=60
JEV_MAX_RETRIES=1
JEV_MAX_REQUESTS_PER_RUN=1
JEV_CONFIDENCE_WARNING=0.70
JEV_CONFIDENCE_CRITICAL=0.50
JEV_CACHE_ENABLED=true

# CrewAI local orchestration. Keep disabled until optional dependency/LLM setup.
CREWAI_ENABLED=false
CREWAI_LLM_MODEL=openai/meta-llama-3-8b-instruct
CREWAI_LLM_BASE_URL=http://127.0.0.1:1234/v1
CREWAI_LLM_API_KEY=lm-studio-local
CREWAI_PROCESS=sequential
# The Core Router remains mandatory. Native CrewAI reasoning is opt-in because
# some local instruct models do not emit the reasoning protocol reliably.
CREWAI_AGENT_REASONING=false
CREWAI_AGENT_MAX_ITER=2
CREWAI_AGENT_MAX_RETRIES=1
CREWAI_AGENT_TIMEOUT_SECONDS=180

# Optional per-role providers for the next model-routing phase.
# Keep remote credentials only in local .env; do not commit them.
CORE_AGENT_MODEL=
CORE_AGENT_BASE_URL=
CORE_AGENT_API_KEY=
SPECIALIST_AGENT_MODEL=
SPECIALIST_AGENT_BASE_URL=
SPECIALIST_AGENT_API_KEY=
REVIEW_AGENT_MODEL=
REVIEW_AGENT_BASE_URL=
REVIEW_AGENT_API_KEY=
SYNTHESIS_AGENT_MODEL=
SYNTHESIS_AGENT_BASE_URL=
SYNTHESIS_AGENT_API_KEY=
RAG_CHAT_MODEL=
RAG_CHAT_BASE_URL=
RAG_CHAT_API_KEY=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Never send raw resume text to a remote model by default.
REMOTE_RESUME_TEXT_ALLOWED=false

# Optional visual SkillGraph prototype. Set false for instant rollback.
SKILLGRAPH_GRAPH_ENABLED=true

# Langfuse observability (optional; no-op when disabled).
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=skillgraph-local
LANGFUSE_SAMPLE_RATE=1.0
OBS_P95_ALERT_MS=5000
OBS_ERROR_RATE_ALERT=0.05

# Slack alerts: disabled until a Bot User OAuth Token and channel ID are configured.
SLACK_ALERTS_ENABLED=false
SLACK_BOT_TOKEN=replace-with-xoxb-bot-user-oauth-token
SLACK_CHANNEL_ID=replace-with-slack-channel-id
SLACK_ALERT_COOLDOWN_SECONDS=900

# Resume/document handling defaults.
RESUME_RETENTION_MODE=ephemeral
RESUME_MAX_SIZE_MB=10
RESUME_DELETE_AFTER_PROCESSING=true
RESUME_STORE_FULL_TEXT=false
OCR_ENABLED=true
OCR_MAX_PAGES=10
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_MODEL=meta-llama-3-8b-instruct
EVAL_JUDGE_BASE_URL=http://127.0.0.1:1234/v1
EVAL_JUDGE_API_KEY=lm-studio-local
EVAL_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EVAL_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EVAL_EMBEDDING_API_KEY=lm-studio-local
TOXICITY_THRESHOLD=0.90
TOXICITY_LIVE_ENABLED=false
