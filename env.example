# SkillGraph — configuração de ambiente sem segredos
#
# Copie este arquivo para .env antes de executar localmente:
#   cp env.example .env
#
# Nunca publique o arquivo .env nem coloque chaves reais no Git.
# No Streamlit Community Cloud, use Settings > Secrets e mantenha os mesmos nomes.

# -----------------------------------------------------------------------------
# 1. Ambiente local e Dify
# -----------------------------------------------------------------------------
# Versão do Dify usada pelo bootstrap local. O Dify local é usado no desenvolvimento;
# em produção, substitua a URL pela API pública do Dify Cloud.
DIFY_VERSION=1.17.0
DIFY_DIR=.dify

# Servidor local do LM Studio. O modelo de chat interpreta solicitações e apoia o
# CrewAI no desenvolvimento local. Dentro do Docker, use host.docker.internal.
LM_STUDIO_HOST=127.0.0.1
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio-local
LM_STUDIO_CHAT_MODEL=gemini-3.1-flash-lite
LM_STUDIO_EMBEDDING_MODEL=gemini-embedding-001

# API do Chatflow publicado no Dify. Estas são as credenciais do Dify, não do Gemini.
# Local: http://localhost ou a URL definida pela instalação local.
# Produção: URL pública da instância Dify Cloud, normalmente https://api.dify.ai/v1.
DIFY_API_BASE_URL=http://localhost
DIFY_API_KEY=replace-with-your-dify-chatflow-api-key
DIFY_USER_ID=skillgraph-local-user
DIFY_MAX_RETRIES=0
DIFY_RETRY_BACKOFF_SECONDS=1
DIFY_CONNECT_TIMEOUT_SECONDS=10
DIFY_READ_TIMEOUT_SECONDS=60
DIFY_TOTAL_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# 2. Gemini — síntese final e provider de produção
# -----------------------------------------------------------------------------
# Chave da API Google Gemini. Esta é a credencial principal do Gemini e não deve
# ser confundida com DIFY_API_KEY ou com as chaves do Langfuse.
# No Streamlit Cloud, crie o secret GEMINI_API_KEY com a chave real.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_ATTEMPTS=1
GEMINI_ALLOW_FALLBACK=false
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=1200
# Tarifas opcionais por 1 milhão de tokens. Deixe vazio para não inventar custo.
GEMINI_INPUT_USD_PER_1M=
GEMINI_OUTPUT_USD_PER_1M=

# -----------------------------------------------------------------------------
# 3. CrewAI e agentes
# -----------------------------------------------------------------------------
# O CrewAI é obrigatório nas rotas de domínio do chat principal.
CREWAI_ENABLED=true
# Local: LM Studio via endpoint OpenAI-compatible.
# Produção: Gemini via LiteLLM; a chave pode reutilizar GEMINI_API_KEY.
CREWAI_LLM_MODEL=gemini/gemini-3.1-flash-lite
CREWAI_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
CREWAI_LLM_API_KEY=
CREWAI_PROCESS=sequential
CREWAI_AGENT_REASONING=false
CREWAI_AGENT_MAX_ITER=2
CREWAI_AGENT_MAX_RETRIES=1
CREWAI_AGENT_TIMEOUT_SECONDS=180
CREWAI_PYTHON=.venv/bin/python

# Provider usado pela interpretação do perfil ML. Em local, pode apontar ao LM Studio;
# em produção, configure um endpoint Gemini/OpenAI-compatible acessível.
ML_INTERPRETER_PROVIDER=gemini
ML_INTERPRETER_MODEL=gemini-3.1-flash-lite
ML_INTERPRETER_API_KEY=
ML_INTERPRETER_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# -----------------------------------------------------------------------------
# 4. Currículos, OCR e JEV
# -----------------------------------------------------------------------------
# JEV/TypeSafe é opcional e recebe somente texto sanitizado do currículo.
JEV_ENABLED=false
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key
JEV_API_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=60
JEV_MAX_RETRIES=1
JEV_MAX_REQUESTS_PER_RUN=1
JEV_VERIFY_TLS=true

# Limites de upload e OCR local. Instale o Tesseract e os pacotes por/eng quando
# quiser testar PDFs escaneados.
RESUME_MAX_SIZE_MB=10
OCR_ENABLED=true
OCR_LANG=por+eng
OCR_MAX_PAGES=10
TESSERACT_CMD=
RESUME_RETENTION_MODE=ephemeral
RESUME_DELETE_AFTER_PROCESSING=true
RESUME_STORE_FULL_TEXT=false

# -----------------------------------------------------------------------------
# 5. Langfuse e alertas
# -----------------------------------------------------------------------------
# As três linhas de credencial abaixo são do Langfuse: public key, secret key e
# endereço do projeto. Elas ativam tracing externo sanitizado; não são credenciais
# do Dify nem do Gemini. Use LANGFUSE_ENABLED=true somente após preencher as chaves.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_RELEASE=skillgraph-cloud
LANGFUSE_ENVIRONMENT=production
LANGFUSE_SAMPLE_RATE=1.0

# Alertas opcionais no Slack; mantenha desabilitados se não forem necessários.
SLACK_ALERTS_ENABLED=false
SLACK_BOT_TOKEN=replace-with-xoxb-bot-user-oauth-token
SLACK_CHANNEL_ID=replace-with-slack-channel-id
SLACK_ALERT_COOLDOWN_SECONDS=900

# -----------------------------------------------------------------------------
# 6. Avaliação, persistência e observabilidade local
# -----------------------------------------------------------------------------
# DeepEval é executado somente de forma explícita e pode consumir quota do Gemini.
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
EVAL_JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_TIMEOUT_SECONDS=60
EVAL_EMBEDDING_MODEL=gemini-embedding-001
EVAL_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EVAL_EMBEDDING_API_KEY=
EVAL_EMBEDDING_TIMEOUT_SECONDS=60

# O app usa estes diretórios locais; em cloud, aponte para diretórios graváveis.
SKILLGRAPH_STATE_DIR=state
SKILLGRAPH_DATA_DIR=data_bd
OBSERVABILITY_LOG_PATH=logs/skillgraph.jsonl
STARTUP_PROFILE=false
SKILLGRAPH_GRAPH_ENABLED=true

# Segurança e toxicidade. A verificação online de toxicidade permanece desligada
# por padrão; os guardrails determinísticos continuam ativos.
TOXICITY_THRESHOLD=0.90
TOXICITY_LIVE_ENABLED=false
OBS_P95_ALERT_MS=5000
