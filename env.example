# Dify release to install. Keep this pinned for reproducible setup.
DIFY_VERSION=1.17.0

# Local installation directory. It is ignored by git.
DIFY_DIR=.dify

# LM Studio OpenAI-compatible server on the host machine.
LM_STUDIO_HOST=127.0.0.1
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Optional model IDs. Discover exact values with: make check
# LM_STUDIO_CHAT_MODEL=your-chat-model-id
# LM_STUDIO_EMBEDDING_MODEL=your-embedding-model-id

# LM Studio commonly accepts any placeholder key. Do not put a real secret here.
LM_STUDIO_API_KEY=lm-studio-local

# Published Dify Chatflow API (keep the real key only in local .env)
DIFY_API_BASE_URL=http://localhost
DIFY_API_KEY=replace-with-your-local-dify-chatflow-key
DIFY_USER_ID=skillgraph-local-user

# Models used by the Dify provider and its managed RAG pipeline.
LM_STUDIO_CHAT_MODEL=meta-llama-3-8b-instruct
LM_STUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# The Dify Chatflow and its managed vector store are the main RAG pipeline.
# Do not put real keys in env.example.

# Do not put real keys in env.example.
