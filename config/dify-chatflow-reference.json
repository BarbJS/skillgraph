{
  "app_name": "SkillGraph — RAG Corporativo — v0.1",
  "app_type": "chatflow",
  "published": true,
  "rag_backend_reference": "Dify Chatflow with its managed vector store (Weaviate in this local deployment); this is the only RAG backend",
  "llm_provider": "Google Gemini",
  "chat_model": "gemini-3.1-flash-lite",
  "embedding_model": "gemini-embedding-001",
  "knowledge_base": "SkillGraph - v1.2",
  "retrieval": {
    "mode": "parent-child",
    "parent_separator": "\\n\\n",
    "parent_max_characters": 1024,
    "child_separator": "\\n",
    "child_max_characters": 512,
    "index_mode": "high_quality",
    "search_mode": "vector",
    "top_k": 3,
    "reranker": false,
    "score_threshold": false
  },
  "nodes": [
    "start",
    "knowledge-retrieval",
    "llm",
    "answer"
  ],
  "system_prompt_reference": "../docs/system-prompt.md",
  "secrets": "API keys are intentionally omitted. Configure them only in the deployment secret store."
}
